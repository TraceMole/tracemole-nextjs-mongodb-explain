{
  "name": "tracemole-js",
  "private": true,
  "description": "Open-source TraceMole SDKs: OpenTelemetry + MongoDB explain for Next.js and Node",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check-types": "npm run check-types --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.15.3",
    "tsup": "^6.5.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
